# ── Ollama (local LLM) ────────────────────────────────────────────────
# OpenAI-compatible Chat Completions endpoint
OLLAMA_BASE_URL=http://localhost:11434/v1
# Model ID — no "ollama/" prefix; it is added in code (DESIGN §4.1)
# Tool-calling gate PASSED 2026-11-11 (scripts/probe-tool-calling.py, 2/2 runs)
OLLAMA_MODEL=Swift-Qwen3.8-27B-Q4_K_S:latest

# ── Portal MCP server ─────────────────────────────────────────────────
# Streamable HTTP endpoint of mastra-nipp-mcp
PORTAL_MCP_URL=http://localhost:4112/api/mcp/nipp-portal/mcp

# ── BetterAuth (shared session with the portal) ───────────────────────
# MUST be byte-identical to nipp-0111's BETTER_AUTH_SECRET.
# Rotation procedure: update BOTH apps, restart BOTH.
BETTER_AUTH_SECRET=
*** Portal origin (session cookie base)
BETTER_AUTH_URL=http://localhost:3000
# Shared PostgreSQL for session verification (portal's PgBouncer URL)
DATABASE_URL=

# ── Client-side (chat UI) ─────────────────────────────────────────────
# Login redirect target shown in the sign-in banner
NEXT_PUBLIC_PORTAL_URL=http://localhost:3000

# ── Server ────────────────────────────────────────────────────────────
# Next.js dev server port (portal uses 3000, MCP server uses 4112)
PORT=3001
